# macOS
.DS_Store

# Build output — the packed app is published as a Release asset, not committed
# (its Electron framework binary is 183 MB, over GitHub's 100 MB file limit)
OKMD.app/
dist/
*.zip

# Signing — private keys and certificates. Never commit these. Once a key is in
# the history of a public repo, deleting it later does not remove it; the only
# fix is revoking the certificate.
*.p12
*.pfx
*.p8
*.cer
*.certSigningRequest
*.provisionprofile

# Scratch
_to_delete/

# Node
node_modules/

# GUIDE record — local index, never committed
guide.json
